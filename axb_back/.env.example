# ============================================
# 安行伴后端环境配置示例
# ============================================
# 复制此文件为 .env 并修改配置值
# 命令：cp .env.example .env

# ============================================
# 应用基础配置
# ============================================
APP_NAME=anxingban
ENVIRONMENT=development  # development/production
PORT=8000

# ============================================
# 数据库配置
# ============================================
# MySQL连接字符串格式：mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
# Docker环境：使用mysql作为主机名
# 本地环境：使用localhost作为主机名
DATABASE_URL=mysql+pymysql://ivan:123456@localhost:3306/anxingban?charset=utf8mb4

# 测试数据库（用于运行pytest）
TEST_DATABASE_URL=mysql+pymysql://ivan:123456@localhost:3306/anxingban_test?charset=utf8mb4

# ============================================
# 安全配置
# ============================================
# JWT密钥（用于Token签名）
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-please-change-this-in-production

# 通行码密钥（用于动态通行码HMAC签名）
TOKEN_SECRET=your-token-secret-please-change-this-in-production

# JWT算法
ALGORITHM=HS256

# Token过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7天

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO  # DEBUG/INFO/WARNING/ERROR
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=10

# ============================================
# 通知服务配置
# ============================================
# 短信提供商：mock（模拟）/aliyun（阿里云）/tencent（腾讯云）
SMS_PROVIDER=mock

# 企业微信Webhook URL（可选，用户在档案中配置）
# 如需全局默认Webhook，可在此配置
WECHAT_WEBHOOK_URL=

# ============================================
# 业务配置
# ============================================
# 试点城市
PILOT_CITY=Chongqing

# 景点讲解范围：knowledge_limited（仅限知识库）
GUIDE_SCOPE=knowledge_limited

# ============================================
# Agent配置（可选，用于集成自定义问答Agent）
# ============================================
# 是否启用Agent功能
AGENT_ENABLED=false

# Agent服务地址（您开发的Agent服务URL）
# 示例：http://localhost:8001
AGENT_BASE_URL=

# Agent API密钥（如果您的Agent服务需要认证）
AGENT_API_KEY=

# Agent请求超时时间（秒）
AGENT_TIMEOUT=30

# ============================================
# 开发环境配置（仅开发时使用）
# ============================================
# 是否启用热重载
# RELOAD=true

# 是否显示详细错误信息
# DEBUG=true

# ============================================
# Docker环境配置说明
# ============================================
# 使用Docker Compose启动：
# 1. 确保已安装Docker和Docker Compose
# 2. 运行: docker-compose up -d
# 3. 访问: http://localhost:8000
# 4. API文档: http://localhost:8000/docs
#
# Docker环境下数据库连接会自动配置，无需修改DATABASE_URL
