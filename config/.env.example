# ============================================
# 安行伴后端环境变量配置示例
# ============================================
# 复制此文件为 .env 并填写实际配置值

# 应用基础配置
APP_NAME=安行伴-重庆试点
ENVIRONMENT=development
PORT=8000

# 数据库配置
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/anxingban?charset=utf8mb4

# 安全配置
# 重要: 生产环境必须使用强随机密钥
# 可以使用 python -c "import secrets; print(secrets.token_urlsafe(32))" 生成
TOKEN_SECRET=your-token-secret-here
SECRET_KEY=your-jwt-secret-key-here

# 微信配置
# 企业微信Webhook URL (可选)
WECHAT_WEBHOOK_URL=

# 短信配置
# 可选值: mock (模拟测试), aliyun (阿里云), tencent (腾讯云)
SMS_PROVIDER=mock

# 业务配置
PILOT_CITY=Chongqing
GUIDE_SCOPE=knowledge_limited

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=104857600
LOG_BACKUP_COUNT=10
