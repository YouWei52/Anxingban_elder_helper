# 测试环境配置
# 使用 SQLite 进行测试（无需 MySQL 服务）
TEST_DATABASE_URL=sqlite:///./test_anxingban.db
# 或使用内存数据库（更快）：TEST_DATABASE_URL=sqlite:///:memory:

# 如果需要使用 MySQL 测试，取消注释下面一行：
# TEST_DATABASE_URL=mysql+pymysql://root:password@localhost:3306/anxingban_test

SECRET_KEY=test_secret_key_min_32_characters_long_for_jwt
ENV=test
DEBUG=False
